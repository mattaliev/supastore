# ---- Core ----
# Postgres connection string: postgres://USER:PASSWORD@HOST:5432/DBNAME
# On Railway this is provided automatically by the Postgres plugin.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/supastore
DEBUG=True
SECRET_KEY=
JWT_SECRET_KEY=

# ---- Encryption ----
# AES_SECRET_KEY must base64-decode to 32 bytes, AES_IV to 16 bytes.
# Generate: openssl rand 32 | base64   and   openssl rand 16 | base64
AES_SECRET_KEY=
AES_IV=

# ---- Service URLs ----
SERVICE_URL=http://localhost:8000
FRONTEND_CLIENT_URL=http://localhost:3001
ADMIN_CLIENT_URL=http://localhost:3000

# ---- Telegram (3 bots: shop, support, admin) ----
TELEGRAM_API_URL=https://api.telegram.org
TELEGRAM_SHOP_BOT_USERNAME=
TELEGRAM_SHOP_TOKEN=
TELEGRAM_SUPPORT_BOT_USERNAME=
TELEGRAM_SUPPORT_TOKEN=
TELEGRAM_ADMIN_BOT_TOKEN=
TELEGRAM_WEB_APP_URL=http://localhost:3001
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_SUPPORT_CHAT_ID=
SUPERUSER_TELEGRAM_ID=

# ---- Payments ----
# Wallet Pay credentials are configured per-store in the admin (encrypted in
# the DB), not here. Only the post-payment return URL (the tg-shop) is needed.
TELEGRAM_PAYMENT_RETURN_URL=http://localhost:3001
